{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jev-hooks-demo",
  "account_id": "97c691498b367789962e77080bf302c0",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../.playground-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "DemoBudget" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoBudget"] }],
  "ratelimits": [
    {
      "name": "BURST",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vars": {
    "LIVE_ENABLED": "true",
    "IP_MINUTE_LIMIT": "60",
    "IP_DAILY_LIMIT": "1000",
    "DAILY_LIMIT": "10000",
  },
  "observability": { "enabled": false },
}
