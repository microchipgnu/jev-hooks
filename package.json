{
  "name": "jev-hooks",
  "version": "0.2.0",
  "description": "Compose typed Jev judgments as reactive semantic state, in React and backend programs.",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/checker/check.d.ts",
      "import": "./dist/checker/check.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "bin": {
    "jev-check": "dist/checker/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm typecheck && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && pnpm check:programs",
    "check:programs": "tsx src/checker/cli.ts",
    "test": "vitest run",
    "test:workers": "vitest run tests/workers.test.ts",
    "test:providers:live": "node --env-file-if-exists=.env --import tsx tests/providers.live.ts",
    "demo:worker": "pnpm check:programs && wrangler dev --config examples/worker/wrangler.jsonc",
    "build:worker": "pnpm check:programs && node scripts/build-worker.mjs",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "prepack": "pnpm build",
    "demo:triage": "pnpm check:programs && tsx examples/triage.ts",
    "demo:research": "pnpm check:programs && tsx examples/research.ts",
    "demo:clock": "pnpm check:programs && tsx examples/clock.ts",
    "demo:replay": "pnpm check:programs && tsx examples/replay.ts",
    "demo:chat": "pnpm check:programs && tsx examples/chat.ts",
    "demo:triage:live": "pnpm check:programs && tsx examples/triage.ts --live",
    "demo:research:live": "pnpm check:programs && tsx examples/research.ts --live",
    "demo:clock:live": "pnpm check:programs && tsx examples/clock.ts --live",
    "demo:chat:live": "pnpm check:programs && tsx examples/chat.ts --live",
    "test:openrouter:live": "node --env-file-if-exists=.env --import tsx tests/native-openrouter.live.ts",
    "demo:react": "vite --config examples/react/vite.config.ts",
    "build:react": "vite build --config examples/react/vite.config.ts",
    "build:demo": "vite build --config examples/monitor/vite.config.ts && pnpm build:docs",
    "deploy:demo": "pnpm build:demo && wrangler deploy --config examples/demo-worker/wrangler.jsonc",
    "demo:village": "vite --config examples/village/vite.config.ts",
    "build:village": "vite build --config examples/village/vite.config.ts",
    "dev:village:api": "wrangler dev --config examples/demo-worker/wrangler.jsonc",
    "demo:monitor": "vite --config examples/monitor/vite.config.ts",
    "build:monitor": "vite build --config examples/monitor/vite.config.ts && pnpm build:docs",
    "dev:monitor:api": "wrangler dev --config examples/demo-worker/wrangler.jsonc",
    "build:docs": "pnpm build && node scripts/build-docs.mjs",
    "test:docs": "node scripts/test-docs.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.0",
    "marked": "18.0.13",
    "miniflare": "5.20260918.0-alpha",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "homepage": "https://jev-hooks-demo.microchipgnu.workers.dev/docs/",
  "keywords": [
    "jev",
    "typesafe",
    "react",
    "hooks",
    "semantic-state",
    "reactive",
    "cloudflare",
    "vercel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microchipgnu/jev-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/microchipgnu/jev-hooks/issues"
  }
}
